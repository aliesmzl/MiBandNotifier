.page {
  flex-direction: column;
  padding: 12px;
}
.header {
  margin-bottom: 10px;
}
.title {
  font-size: 20px;
  color: #ffffff;
  font-weight: bold;
}
.form {
  margin-bottom: 12px;
}
.label {
  font-size: 14px;
  color: #b0bec5;
  margin-bottom: 6px;
}
.input {
  height: 40px;
  padding: 8px;
  border-radius: 8px;
  background-color: #263238;
  color: #ffffff;
  font-size: 14px;
}
.hint {
  margin-top: 6px;
}
.hint-text {
  font-size: 11px;
  color: #78909c;
}
.actions {
  flex-direction: row;
  justify-content: center;
}
.button {
  margin: 8px;
  padding: 10px 24px;
  border-radius: 10px;
  background-color: #1976d2;
}
.button.secondary {
  background-color: #455a64;
}
.button-text {
  font-size: 15px;
  color: #ffffff;
}
</style>
